
# manual tool change
#net tool-change      		hal_manualtoolchange.change   <=  iocontrol.0.tool-change
#net tool-changed     		hal_manualtoolchange.changed  <=  iocontrol.0.tool-changed
#net tool-prep-number 		hal_manualtoolchange.number   <=  iocontrol.0.tool-prep-number
#net tool-prepare-loopback 	iocontrol.0.tool-prepare      =>  iocontrol.0.tool-prepared

# automatic tool change 
net tool-change-loop iocontrol.0.tool-change iocontrol.0.tool-changed
net tool-prep-loop iocontrol.0.tool-prepare iocontrol.0.tool-prepared


# used for the dialog box on manual tool changes
net manual-tool-change      hal_manualtoolchange.change     <= motion.digital-out-01
net manual-tool-changed     motion.digital-in-02            <= hal_manualtoolchange.changed
net manual-tool-number      hal_manualtoolchange.number     <= iocontrol.0.tool-prep-number
#net probe-installed	    motion.digital-in-03	    <= spindle.0.inhibit
net touch-probe-sense => motion.digital-in-03
#net manual-tool-button      hal_manualtoolchange.change_button 

# probe LED
net probe-in  =>  qtdragon.led-probe
net probe-not-ready => qtdragon.led-probe-fault

# override lights
net enc0-feedoverride-en => qtdragon.led-feedrate-override
net enc0-spinoverride-en => qtdragon.led-spindle-override

# spindle gauge
net vfd-motor-speed => qtdragon.gauge_spindle_value
net spindle-amps => qtdragon.spindle-amps
net spindle-volts => qtdragon.spindle-volts
#net spindle-gauge-rpm qtdragon.gauge_spindle_value <= spindle-vel-rpm
#net spindle-vel-rpm-abs => qtdragon.gauge_spindle_setpoint
